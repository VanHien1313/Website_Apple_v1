{
  "name": "apple-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "catalog:prepare": "node deploy/prepare-catalog.mjs",
    "catalog:import": "node deploy/catalog-local.mjs",
    "test:catalog": "node --experimental-strip-types --test deploy/catalog.test.mjs",
    "demo:start": "node deploy/demo-local.mjs start",
    "demo:stop": "node deploy/demo-local.mjs stop",
    "demo:status": "node deploy/demo-local.mjs status",
    "test:demo": "node --experimental-strip-types --test deploy/demo/catalog.test.mjs",
    "demo:verify": "node deploy/demo-verify.mjs",
    "test:backend:docker": "node deploy/test-backend-docker.mjs",
    "staging:check": "node deploy/staging-preflight.mjs",
    "staging:host-check": "node deploy/staging-host-check.mjs",
    "test:deployment": "node --test deploy/staging-preflight.test.mjs deploy/staging-host.test.mjs",
    "build:release": "npm --prefix backend run build && npm --prefix frontend run build:api",
    "start:release": "node --env-file-if-exists=backend/.env backend/dist/server.js",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix frontend run dev:api",
    "build:api": "npm --prefix frontend run build:api",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend test",
    "typecheck": "npm --prefix frontend run typecheck",
    "backend:dev": "npm --prefix backend run dev",
    "backend:build": "npm --prefix backend run build",
    "backend:test": "npm --prefix backend test",
    "backend:typecheck": "npm --prefix backend run typecheck",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed"
  }
}
