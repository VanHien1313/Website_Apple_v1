{
  "name": "apple-web-store",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "build:api": "tsc -b && vite build --mode api",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:api": "vite preview --mode api",
    "typecheck": "tsc -b",
    "test:boundary": "node scripts/check-runtime-boundary.mjs",
    "test": "tsc --project tsconfig.test.json && node scripts/test.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "esbuild": "^0.25.12"
  }
}
