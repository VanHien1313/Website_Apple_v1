# Copy to deploy/secrets/payment-sandbox.env, then edit privately on this machine.
# This example contains no credentials. Never paste real keys into chat or Git.
PAYMENT_MODE=sandbox
PAYMENT_PUBLIC_ORIGIN=https://your-public-https-host.example
# Configure one or both providers. Remove/comment all settings for an unused provider.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
