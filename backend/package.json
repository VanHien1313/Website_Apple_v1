{
  "name": "aura-backend",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "tedious": "19.2.2",
    "@azure/identity": "4.13.0",
    "@azure/msal-node": {
      "uuid": "11.1.1"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test:frontend": "node --experimental-strip-types scripts/frontend-smoke.mjs",
    "admin:bootstrap": "node --env-file-if-exists=.env --experimental-strip-types src/auth/bootstrap-cli.ts",
    "dev": "node --env-file-if-exists=.env --watch --experimental-strip-types src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --experimental-strip-types src/db/cli.ts seed",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "msnodesqlv8": "6.0.0",
    "mssql": "12.7.11",
    "qrcode": "1.5.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mssql": "12.3.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "typescript": "5.9.3"
  }
}
