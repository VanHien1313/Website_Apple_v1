NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# true serves frontend/dist-api from Express; APP_ORIGIN must match the address users open.
SERVE_FRONTEND=false
APP_ORIGIN=http://127.0.0.1:3000
# Leave empty for direct/local requests. Only explicit trusted proxy IPs, comma-separated.
TRUST_PROXY_IPS=
DB_SERVER=.\SQLEXPRESS
DB_DATABASE=AuraStore
DB_AUTH=windows
DB_ENCRYPT=true
# Local self-signed certificate only; must be false in production.
DB_TRUST_SERVER_CERTIFICATE=true
# SQL authentication (Docker/Linux): DB_AUTH=sql, DB_USER, DB_PASSWORD, DB_PORT=1433
# Or DB_PASSWORD_FILE=/run/secrets/sql_app_password (do not set both password sources).
ALLOW_DEMO_SEED=false

# Optional wallet integration. Default off; sandbox requires public HTTPS callbacks.
PAYMENT_MODE=off
# PAYMENT_PUBLIC_ORIGIN=https://your-public-host.example
# MOMO_PARTNER_CODE=
# MOMO_ACCESS_KEY_FILE=/run/secrets/momo_access_key
# MOMO_SECRET_KEY_FILE=/run/secrets/momo_secret_key
# ZALOPAY_APP_ID=
# ZALOPAY_KEY1_FILE=/run/secrets/zalopay_key1
# ZALOPAY_KEY2_FILE=/run/secrets/zalopay_key2
